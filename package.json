{
  "name": "depthgate",
  "productName": "DEPTHGATE",
  "version": "1.5.0",
  "description": "DEPTHGATE — dark fantasy dungeon crawler RPG com campanha, cinco classes e modo Endless procedural.",
  "type": "module",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "desktop:dev": "vite build && electron .",
    "desktop:build": "vite build && electron-builder --win",
    "mobile:sync": "vite build && npx cap sync android",
    "mobile:android": "cd android && gradlew assembleDebug"
  },
  "build": {
    "appId": "com.rafaelscarpille.depthgate",
    "productName": "DEPTHGATE",
    "electronDist": "node_modules/electron/dist",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "electron/**"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "portable": {
      "artifactName": "DEPTHGATE-Portable.exe"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "DEPTHGATE-Setup.exe"
    }
  },
  "dependencies": {
    "@capacitor/core": "^8.5.0",
    "phaser": "^4.2.1"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/cli": "^8.5.0",
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3",
    "vite": "^7.1.0"
  }
}
